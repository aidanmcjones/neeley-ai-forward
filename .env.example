# Copy to .env (never commit .env). On Streamlit Cloud, set this under App settings > Secrets.
ANTHROPIC_API_KEY=

# SEC asks for a descriptive User-Agent with a contact address
SEC_USER_AGENT=

# Optional: Cloudflare R2 for the filing archive (agent/tenk.py). Without these, files go to data/sec/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=neeley-ai-forward
